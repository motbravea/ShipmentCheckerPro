{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShipmentChecker Pro Demo",
  "version": "0.1.2",
  "identifier": "com.shipmentchecker.pro.demo",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-before-dev.ps1",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-before-build.ps1",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShipmentChecker Pro",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/ShipmentCheckerPro.Api"
    ],
    "resources": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}

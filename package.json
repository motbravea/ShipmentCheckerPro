{
  "name": "shipmentchecker-pro-workspace",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/desktop-dev.ps1",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/desktop-build.ps1",
    "frontend:dev": "npm --prefix ./frontend run dev",
    "frontend:build": "npm --prefix ./frontend run build",
    "backend:dev": "dotnet run --project ./backend/ShipmentCheckerPro.Api.csproj",
    "backend:build": "dotnet build ./backend/ShipmentCheckerPro.Api.csproj",
    "prepare:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-tauri-sidecar.ps1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1"
  }
}
